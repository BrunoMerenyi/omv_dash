# Copy to .env next to compose.yml and adjust. Never commit .env.

# --- General ---
DEMO_MODE=false
# Header title. Empty = the server's hostname.
DASH_TITLE=
PORT=6767
# Bind address. 0.0.0.0 = all interfaces of the NAS. Put the LAN IP here
# (e.g. 192.168.1.20) to listen on the LAN interface only.
HOST=0.0.0.0

# Group id of the "docker" group on the NAS: `getent group docker | cut -d: -f3`
DOCKER_GID=999

# --- System (empty = automatic) ---
HOST_IP=
NET_IFACE=
TOP_PROCESSES=8

# --- Sensors (names from `sensors` or /sys/class/hwmon/*/name) ---
SENSOR_CPU_CHIP=k10temp
SENSOR_BOARD_CHIP=nct6798
SENSOR_BOARD_LABEL=SYSTIN

# --- Storage ---
POOL_PATH=/srv/mergerfs/pool
# Comma-separated disk names to show; empty = all physical disks
DISKS=

# --- SMART (see README) ---
SMART_SOURCE=auto
SMART_DIR=/smart
SMART_INTERVAL=1800

# --- Docker ---
DOCKER_INTERVAL=5

# --- Jellyfin: Dashboard -> API Keys -> + ---
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=

# --- Minecraft (Java edition) ---
MC_HOST=127.0.0.1
MC_PORT=25565
